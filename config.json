{
  "network": "mainnet",
  "ws_url": "wss://api.hyperliquid.xyz/ws",
  "symbols": [
    "BTC",
    "ETH",
    "SOL"
  ],
  "candle_interval": "1m",
  "subscriptions": [
    "trades",
    "candle",
    "bbo",
    "allMids"
  ],
  "runtime": {
    "reconnect_seconds": 5,
    "max_bars": 500,
    "warmup_bars": 240
  },
  "thresholds": {
    "zscore_entry": -1.5,
    "zscore_exit": -0.2,
    "rel_volume_min": 1.0,
    "squeeze_width_pct": 0.15,
    "macd_positive_only": true,
    "risk_config_v1": {
      "account_equity": 10000.0,
      "cash_available": 10000.0,
      "sizing_model": "atr",
      "risk_pct_per_trade": 0.01,
      "atr_stop_multiplier": 2.0,
      "rr_ratio": 2.5,
      "min_quantity": 0.001,
      "max_quantity": 0.5,
      "max_position_pct": 0.10,
      "kelly_fraction": 0.25,
      "max_kelly_pct": 0.05,
      "min_trades_for_kelly": 20,
      "fixed_quantity": 0.01,
      "max_concurrent_candidates": 2,
      "max_symbol_notional_fraction": 0.15,
      "max_portfolio_gross_fraction": 0.40,
      "per_trade_risk_fraction": 0.01,
      "session_loss_limit_fraction": 0.05,
      "spread_bps_limits": {
        "default": 8.0,
        "flow_imbalance_momentum": 6.0,
        "macd_trend_continuation": 8.0,
        "ema_pullback_continuation": 8.0,
        "mean_reversion": 10.0
      },
      "micro_volatility_limits": {
        "default": 0.008,
        "flow_imbalance_momentum": 0.006,
        "macd_trend_continuation": 0.008,
        "ema_pullback_continuation": 0.008
      },
      "kill_switch": {
        "active": false
      },
      "portfolio_state": {
        "active_positions_count": 0,
        "gross_exposure": 0.0,
        "net_exposure": 0.0,
        "session_realized_pnl": 0.0,
        "symbol_exposure": {}
      }
    }
  },
  "execution": {
    "fees_bps": 5,
    "slippage_bps": 3,
    "sizing_mode": "fixed_fraction",
    "max_fraction_per_trade": 0.02
  }
}
